# Copy to .env and adjust as needed. .env is git-ignored.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://financeflow:financeflow@localhost:5432/financeflow
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Host port for docker compose (change if 5432 is already in use, and update DATABASE_URL).
POSTGRES_PORT=5432
